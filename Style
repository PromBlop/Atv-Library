/* style do index */

.body {
    background-color: hsl(40 30% 94%);
    color: hsl(221, 49%, 27%);
    text-align: center;
    max-width: 60rem;
    margin: 0 auto;
    line-height: 1.6;
}

.card {
    background-color: rgb(155, 155, 211);
    padding: 1.2rem;
    border: 3px solid #6261bd;
    border-radius: 2px;
    box-shadow: y 4px blur(12px) alpha(0.12);
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
}



/* teste do "Card p"*/
.card p {
    color: #191cce;
}

.btn:focus-visible {
    outline: 3px solid hsl(221, 49%, 27%);
    outline-offset: 2px;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn {
    background-color: rgb(69, 102, 209);
    color: rgb(71, 14, 136);
    padding: 1.2rem;
    border: 2px solid #191a6d;
    border-radius: 999px;
    letter-spacing: 0.09rem;
    opacity: 1;
    display: block;
    margin: 0 auto;
    gap: 1rem;
    align-items: center;
    cursor: pointer;
    transition: transform 180ms ease-out, background-color 180ms ease-out;
    
}

.btn-primary {
    background-color: darkgoldenrod;
}

.destaque {
    padding: 1rem;
    color: rgb(155, 155, 211);
}



/* H2, P e tals */

h1 {
    color: rgb(0, 116, 194);
    text-align: center;
    font-size: 2rem;
    font-family: 'Arial', 'Helvetica', 'sans-serif';
    line-height: 1.2;
    letter-spacing: -0.01rem;
}

h2 {
    color: rgb(43, 41, 184);
    text-align: center;
    font-size: 2rem;
    font-family: 'Arial', 'Helvetica', 'sans-serif';
    line-height: 1.2;
    letter-spacing: -0.01rem;
}

p {
    font-style: italic;
    color: rgb(71, 14, 136);
    text-align: center;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01rem;
}
